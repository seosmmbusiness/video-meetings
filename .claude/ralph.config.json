{
  "feature": "user-profile",
  "ms": "docs/user-profile/user-profile-MS.json",
  "baseBranch": "main",
  "model": "opus",
  "fallbackModel": "sonnet",
  "maxTurnsPerTask": 200,
  "maxTurnsPerBookend": 120,
  "maxBudgetUsdPerSession": 15,
  "taskRetries": 2,
  "maxSessionsPerRun": 60,
  "maxRunHours": 24,
  "mergeStrategy": "merge",
  "checks": {
    "api": ["lint", "format:check", "test", "test:int:api", "test:e2e:api"],
    "web": ["lint", "format:check", "test", "test:e2e:web"]
  },
  "phases": [
    { "phase": 1, "layer": "api", "needsDb": true },
    { "phase": 2, "layer": "web", "needsDb": true },
    { "phase": 3, "layer": "api", "needsDb": true },
    { "phase": 4, "layer": "web", "needsDb": true },
    { "phase": 5, "layer": "api", "needsDb": true },
    { "phase": 6, "layer": "web", "needsDb": true }
  ]
}
