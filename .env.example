# Postgres (docker-compose)
POSTGRES_USER=video_meetings
POSTGRES_PASSWORD=video_meetings
POSTGRES_DB=video_meetings
POSTGRES_PORT=5432

# apps/api connection string (matches the values above)
DATABASE_URL=postgresql://video_meetings:video_meetings@localhost:5432/video_meetings

# Redis (docker-compose) — optional cache/session store, see README Database
# section: app code must tolerate Redis being unavailable.
REDIS_PORT=6379
REDIS_PASSWORD=video_meetings
REDIS_URL=redis://:video_meetings@localhost:6379

# JWT (apps/api auth)
JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_IN=1h

# CORS (apps/api) — origin allowed to call the API from the browser (apps/web)
CORS_ORIGIN=http://localhost:3000

# apps/web → apps/api base URL, used server-to-server by apps/web's Server
# Actions (apps/web has no .env of its own; it loads this root one via
# @next/env in next.config.ts)
API_BASE_URL=http://localhost:3001

# apps/api file storage root (meeting-file-upload) — where uploaded bytes
# live on disk. Dev-only default when unset: <repo>/.data/uploads, gitignored
# (resolved relative to apps/api's cwd, like DATABASE_URL's .env path above).
# Required (no default) when NODE_ENV=production.
STORAGE_ROOT=../../.data/uploads

# apps/api global rate limit — the baseline every route shares, before the
# stricter per-route overrides (login, upload, download) layered on top of it.
# Unset means 20 requests per 60 s, which is what production runs; the values
# below only widen the baseline for local work. The whole apps/web Playwright
# suite registers its fixtures unauthenticated, so they share one bucket by IP
# and need the headroom — `npm run dev:api:e2e` starts the API with it.
# Anything unparseable, zero or negative falls back to the 20/60 s default.
THROTTLE_LIMIT=200
THROTTLE_TTL_MS=60000

# Whisper transcription engine (docker-compose service `whisper`) — where
# apps/api posts a recording, and the port compose publishes it on. The URL is
# loopback-only on purpose: the engine answers any local process without
# authentication, so the containment is that nothing off this machine can
# reach it. WHISPER_MODEL is read by compose *and* by apps/api, one source of
# truth, and it names the weights `npm run whisper:models` downloads into
# .data/whisper-models/. WHISPER_TIMEOUT_MS bounds one run's wire call; an
# unusable value keeps the shipped 30 minutes rather than widening it.
WHISPER_URL=http://127.0.0.1:9000
WHISPER_PORT=9000
WHISPER_MODEL=tiny
WHISPER_TIMEOUT_MS=1800000
